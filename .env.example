# Modelo de configuração. Copie para .env e ajuste os valores.
# NUNCA versione o .env real (com senhas). Só este .example vai pro repositório.

# ============================================================
# LOCAL (XAMPP) — desenvolvimento
# ============================================================
DB_HOST=127.0.0.1
DB_NAME=gestao_patrimonial
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
APP_ENV=local
# URL base (com barras nas pontas). Local XAMPP = /cezar/
BASE_URL=/cezar/

# ============================================================
# PRODUÇÃO (Hostinger) — descomente e use no servidor
# ============================================================
# DB_HOST=localhost
# DB_NAME=u250260449_cezar_db
# DB_USER=u250260449_mister_db
# DB_PASS=<senha_do_mysql_da_hostinger>
# DB_CHARSET=utf8mb4
# APP_ENV=producao
# BASE_URL=/            (domínio aponta para a própria pasta)
# BASE_URL=/cesar/      (app dentro de uma subpasta)
