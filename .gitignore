# Segredos e ambiente (protege .env, .env.local, .env.producao, etc.)
/.env
/.env.*
!/.env.example

# Uploads de clientes (fora do versionamento)
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess

# Diversos
*.log
.DS_Store

# Pacote temporário de deploy (gerado por ./deploy.sh)
/deploy_pacote/
/deploy_pacote.zip
.claude/
